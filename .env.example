# AI Gateway Configuration — OpenRouter (English-only)
AI_GATEWAY_API_KEY=sk-or-v1-your-openrouter-key
AI_GATEWAY_BASE_URL=https://openrouter.ai/api/v1
# Model for OpenRouter — see https://openrouter.ai/models
AI_GATEWAY_MODEL=openai/gpt-4o-mini

# Web Search API Key (Tencent Cloud WSA)
# Required for the built-in web_search tool. Without this, search falls back
# to no-op (no real results). Obtain from https://console.cloud.tencent.com/
WSA_API_KEY=your-wsa-api-key
